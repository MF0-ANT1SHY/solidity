{
  "language": "Solidity",
    "sources": {
        "after.sol": { "urls": ["after.sol"] }
    },
  "settings": {
    "optimizer": { "enabled": true, "runs": 200 },
    "outputSelection": {
      "*": {
        "*": [
          "abi",
          "metadata",
          "ir",
          "irOptimized",
          "evm.assembly",
          "evm.bytecode.object",
          "evm.deployedBytecode.object",
          "evm.methodIdentifiers",
          "storageLayout"
        ],
        "": [
          "ast"
        ]
      }
    }
  }
}
